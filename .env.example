# Copia este archivo a .env.local (desarrollo) o define estas variables en el
# hosting (preproducción y producción). Nunca subas valores reales a git.

# --- Web pública ---------------------------------------------------------
# Dominio canónico, sin barra final y sin www.
NEXT_PUBLIC_SITE_URL=https://limpiezasgranalva.com
# Preproducción: true (noindex, nofollow y robots «Disallow: /»). Producción: vacío o false.
NEXT_PUBLIC_NOINDEX=
# URL de pedidos de particulares, cuando exista un sistema real. Por defecto: selector de colada.
NEXT_PUBLIC_ORDER_URL=
# WhatsApp Business confirmado, formato internacional sin «+» (p. ej. 34744488964). Vacío = no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Código de verificación de Google Search Console (meta google-site-verification).
GOOGLE_SITE_VERIFICATION=

# --- Payload CMS y PostgreSQL ---------------------------------------------
DATABASE_URL=postgres://usuario:contraseña@host:5432/base_de_datos
# Cadena aleatoria larga (p. ej. `openssl rand -hex 32`), distinta por entorno.
PAYLOAD_SECRET=
# Desarrollo: el esquema se sincroniza solo. Producción: siempre con migraciones (npm run db:migrate).
PAYLOAD_DB_PUSH=

# --- Aviso por correo de nuevas solicitudes (SMTP) -------------------------
# Sin SMTP_HOST las solicitudes se registran igual, con el aviso marcado «pendiente».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=info@limpiezasgranalva.com
CONTACT_TO_EMAIL=info@limpiezasgranalva.com

# --- Antispam (Cloudflare Turnstile, opcional) -----------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Pendientes de fases posteriores ----------------------------------------
# Almacenamiento de medios (fase 3/4): Vercel Blob o S3/R2.
BLOB_READ_WRITE_TOKEN=
# Analítica (solo tras consentimiento de cookies, fase 7).
NEXT_PUBLIC_GA_ID=
