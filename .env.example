# URL pública canónica, sin barra final. WordPress usa hoy la versión sin www;
# mantenerla evita cambiar el canonical que Google ya conoce.
# En preproducción usar la URL de preproducción (y nunca indexarla).
NEXT_PUBLIC_SITE_URL=https://limpiezasgranalva.com

# Payload y PostgreSQL
DATABASE_URL=
PAYLOAD_SECRET=
PREVIEW_SECRET=

# Almacenamiento de medios (elegir y documentar un proveedor)
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Correo del formulario
CONTACT_TO_EMAIL=info@limpiezasgranalva.com
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# Antispam
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analítica y verificación; no cargar sin consentimiento cuando sea exigible
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

